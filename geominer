local rarityColors = {
    ["Common"] = Color3.fromRGB(220, 220, 220),
    ["Uncommon"] = Color3.fromRGB(60, 200, 60),
    ["Rare"] = Color3.fromRGB(60, 120, 220),
    ["Epic"] = Color3.fromRGB(160, 60, 200),
    ["Legendary"] = Color3.fromRGB(255, 215, 0),
    ["Mythic"] = Color3.fromRGB(255, 40, 40),
    ["Godly"] = Color3.fromRGB(0, 255, 255),
    ["Transcendent"] = Color3.fromRGB(0, 255, 255), -- fallback for legacy
    ["Unknown"] = Color3.fromRGB(128, 128, 128),
}

local rarityOrder = {
    ["Godly"] = 0,
    ["Transcendent"] = 0, -- fallback for legacy
    ["Mythic"] = 1,
    ["Legendary"] = 2,
    ["Epic"] = 3,
    ["Rare"] = 4,
    ["Uncommon"] = 5,
    ["Common"] = 6,
    ["Unknown"] = 7,
}

local LEGENDARY_LEVEL = rarityOrder["Legendary"]

local function getOreBaseName(name)
	return name:match("^(.-)_") or name
end

local function updateTableDisplay()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local count = 0
	local search = searchBox.Text:lower()
	local sorted = {}
	for name, _ in pairs(collectedNames) do
		local base = getOreBaseName(name)
		local rarity = oreRarity[base] or "Unknown"
		local rOrder = rarityOrder[rarity] or 7
		if (not ignoreYleobebi or rOrder <= LEGENDARY_LEVEL) and (search == "" or name:lower():find(search, 1, true)) then
			table.insert(sorted, {name = name, rarity = rarity, rOrder = rOrder})
		end
	end
	-- anbanis mixedvit sortireba
	table.sort(sorted, function(a, b)
		if a.rOrder ~= b.rOrder then
			return a.rOrder < b.rOrder
		end
		return a.name < b.name
	end)
	for _, item in ipairs(sorted) do
		count = count + 1
		local entry = Instance.new("TextButton")
		entry.Size = UDim2.new(1, 0, 0, 28)
		entry.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		entry.TextColor3 = rarityColors[item.rarity] or Color3.new(1, 1, 1)
		entry.Font = Enum.Font.SourceSans
		entry.TextSize = 16
		entry.TextXAlignment = Enum.TextXAlignment.Left
		entry.Text = item.name
		entry.Parent = scroll
		entry.MouseButton1Click:Connect(function()
			local miningRemote = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents"):WaitForChild("CollectItem")
			miningRemote:FireServer(item.name)
			collectedNames[item.name] = nil
			updateTableDisplay()
		end)
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, count * 30)
end

ignoreBtn.MouseButton1Click:Connect(function()
	ignoreYleobebi = not ignoreYleobebi
	if ignoreYleobebi then
		ignoreBtn.Text = "Ignore Trash: ON"
		ignoreBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	else
		ignoreBtn.Text = "Ignore Trash: OFF"
		ignoreBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	end
	updateTableDisplay()
end)

searchBox:GetPropertyChangedSignal("Text"):Connect(updateTableDisplay)

-- Keybind J to toggle GUI
local UIS = game:GetService("UserInputService")
UIS.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.J then
		screenGui.Enabled = not screenGui.Enabled
	end
end)

-- Listen logic
local function onItemAdded(item)
	if item and item.Name and not collectedNames[item.Name] then
		collectedNames[item.Name] = true
		updateTableDisplay()
	end
end

listenBtn.MouseButton1Click:Connect(function()
	if listening then return end
	listening = true
	local itemsFolder = workspace:WaitForChild("Items")
	-- Add all current items
	for _, item in ipairs(itemsFolder:GetChildren()) do
		if item and item.Name and not collectedNames[item.Name] then
			collectedNames[item.Name] = true
		end
	end
	updateTableDisplay()
	itemConn = itemsFolder.ChildAdded:Connect(onItemAdded)
end)

stopBtn.MouseButton1Click:Connect(function()
	if not listening then return end
	listening = false
	if itemConn then itemConn:Disconnect() itemConn = nil end
end)

clearBtn.MouseButton1Click:Connect(function()
	for k in pairs(collectedNames) do collectedNames[k] = nil end
	updateTableDisplay()
end)
